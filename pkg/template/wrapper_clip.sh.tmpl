#!/bin/sh
# ==============================================================================
# rlink remote wrapper: System Clipboard Copy ({{.CommandName}})
# Generated automatically by rlink (https://github.com/quaywin/rlink)
# Host Alias: {{.HostAlias}}
# Connection Mode: Reverse SSH Tunnel
# ==============================================================================

set -e

COMMAND_NAME="{{.CommandName}}"
HOST_ALIAS="{{.HostAlias}}"
LOCAL_USER="{{.LocalUser}}"
CONNECT_PORT="{{.ConnectPort}}"
SSH_KEY="{{.SSHKeyPath}}"

show_help() {
    cat <<EOF
rlink wrapper: System Clipboard Copy ($COMMAND_NAME)

Usage:
    command | $COMMAND_NAME
    $COMMAND_NAME [text]
    $COMMAND_NAME <file>

Description:
    Copies piped standard input, text, or file content directly
    into your local machine's system clipboard (pbcopy / wl-copy / xclip).

Options:
    -h, --help      Show this help message
    -c, --check     Test connectivity to local machine
    -v, --version   Show rlink wrapper version

Examples:
    cat token.txt | $COMMAND_NAME
    docker logs my-app | $COMMAND_NAME
    $COMMAND_NAME "Hello from remote server!"
    $COMMAND_NAME README.md
EOF
}

check_connection() {
    echo "Testing reverse tunnel connection back to local machine (127.0.0.1:$CONNECT_PORT)..."
    ssh_opts="-p $CONNECT_PORT -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new -o BatchMode=yes"
    if [ -n "$SSH_KEY" ] && [ -f "$SSH_KEY" ]; then
        ssh_opts="$ssh_opts -i $SSH_KEY"
    fi

    if ssh $ssh_opts "$LOCAL_USER@127.0.0.1" "echo '[rlink] Local machine reachable!'" 2>/dev/null; then
        echo "✓ Successfully connected to local machine."
        exit 0
    else
        echo "✗ Cannot connect to local machine via reverse tunnel ($LOCAL_USER@127.0.0.1:$CONNECT_PORT)."
        echo "  Tip: Ensure you SSH'd into this server with RemoteForward enabled."
        exit 1
    fi
}

case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
    -c|--check)
        check_connection
        exit 0
        ;;
    -v|--version)
        echo "$COMMAND_NAME (rlink remote clipboard copy v0.1.0)"
        exit 0
        ;;
esac

SSH_ARGS="-p $CONNECT_PORT -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
if [ -n "$SSH_KEY" ] && [ -f "$SSH_KEY" ]; then
    SSH_ARGS="$SSH_ARGS -i $SSH_KEY"
fi

REMOTE_CLIP_CMD="export PATH=\"/usr/local/bin:/opt/homebrew/bin:\$HOME/.local/bin:\$PATH\"; pbcopy 2>/dev/null || wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel --clipboard 2>/dev/null"

# If stdin is piped
if [ ! -t 0 ]; then
    cat | ssh $SSH_ARGS "$LOCAL_USER@127.0.0.1" "$REMOTE_CLIP_CMD"
    exit 0
fi

# If argument is provided
if [ $# -gt 0 ]; then
    if [ -f "$1" ]; then
        cat "$1" | ssh $SSH_ARGS "$LOCAL_USER@127.0.0.1" "$REMOTE_CLIP_CMD"
    else
        printf "%s" "$*" | ssh $SSH_ARGS "$LOCAL_USER@127.0.0.1" "$REMOTE_CLIP_CMD"
    fi
    exit 0
fi

show_help
exit 1
